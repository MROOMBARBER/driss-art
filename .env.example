# Firebase WEB configuration (public identifiers, not an admin credential).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_VAPID_KEY=

# Local emulators must never be enabled for a production project/build.
VITE_USE_FIREBASE_EMULATORS=false

# Vercel server-side only. Set securely in the Vercel project settings.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
APP_ORIGIN=https://drissart.com
