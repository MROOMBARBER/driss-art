{
  "name": "xauusd-membership",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:emulator": "vite --mode emulator --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && node scripts/discover-firebase-web.mjs && node scripts/audit-firestore-rules.mjs && node scripts/repair-firestore-rules-once.mjs && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "emulators": "firebase emulators:start --project demo-xauusd --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-xauusd --only firestore 'node --test tests/firestore.rules.test.mjs'",
    "test:api": "node --test tests/push-api.test.mjs tests/admin-bootstrap.test.mjs",
    "test:e2e": "firebase emulators:exec --project demo-xauusd --only auth,firestore 'node scripts/run-e2e.mjs'"
  },
  "dependencies": {
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "firebase-tools": "15.33.0",
    "playwright": "1.60.0",
    "typescript": "7.0.2",
    "vercel": "64.0.2",
    "vite": "8.3.4"
  }
}
